{% extends 'admin.html.twig' %}

{% block admin %}
    <div class="d-flex justify-content-between align-items-center">
        <h1>Invités</h1>
        <a href="#" class="btn btn-primary">Ajouter</a>
    </div>
    <table class="table">
        <thead>
        <tr>
            <th>Nom</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for guest in guests %}
            <tr>
                <td>{{ guest.name }}</td>
                <td>{{ guest.email }}</td>
                <td>
                    {% if guest.deactivationDate %}
                        <form method="POST" action="{{ path('admin_guest_reactivate', {'id': guest.id}) }}" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_guest_reactivate') }}">
                            <button type="submit" class="btn btn-success">Réactiver</button>
                        </form>
                    {% else %}
                        <form method="POST" action="{{ path('admin_guest_deactivate', {'id': guest.id}) }}" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_guest_deactivate') }}">
                            <button type="submit" class="btn btn-warning">Bloquer</button>
                        </form>
                    {% endif %}
                    <a href="#" class="btn btn-danger">Supprimer</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
